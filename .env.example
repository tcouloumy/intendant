# Copy to .env.local. Local values come from `pnpm exec supabase status`.
# Server-only: never prefix with VITE_, or Vite ships them to the browser.

# Postgres (direct connection)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Storage (S3-compatible API)
S3_ENDPOINT=http://127.0.0.1:54421/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=imports

# Auth (Supabase implementation)
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=
